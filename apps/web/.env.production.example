# Production environment variables for SafeFamily web app.
#
# DO NOT commit a populated .env.production file — it is gitignored.
# Supply these values via your CI/CD pipeline (e.g. GitHub Actions secrets,
# Vercel environment variables, Netlify env, or a Docker build-arg).
#
# Usage:
#   cp .env.production.example .env.production
#   # then fill in the real values before running: vite build

# Backend API base URL (no trailing slash)
VITE_API_URL=https://api.safefamily.vn

# Feature flags — explicitly set every flag for production.
# Omitting a flag causes it to default to 'false' (hidden / "Coming Soon" page).
VITE_FEATURE_BOOKING_ENABLED=true
VITE_FEATURE_PLANS_ENABLED=true
VITE_FEATURE_PAYMENTS_ENABLED=true
