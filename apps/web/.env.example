# Copy this file to .env.local and fill in values for local development
VITE_API_URL=http://localhost:5000

# Feature flags — set to 'true' to enable; omit or set to 'false' to disable.
# Defaults to disabled when absent so unreleased features stay hidden in production.
VITE_FEATURE_BOOKING_ENABLED=true
VITE_FEATURE_PLANS_ENABLED=true
VITE_FEATURE_PAYMENTS_ENABLED=true
